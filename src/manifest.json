{
  "name": "光序",
  "appid": "",
  "description": "西建大iOS Club出品校园服务小程序，包括教务系统数据查询，电费、饭卡、校车等校园服务内容",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": []
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "获取位置用于校园地图"
      }
    }
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "mp-baidu": {
    "usingComponents": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "h5": {
    "sdkConfigs": {
      "maps": {
        "amap": {
          "key": "YOUR_AMAP_KEY"
        }
      }
    }
  },
  "uniStatistics": {
    "enable": false
  },
  "vueVersion": "3"
}
